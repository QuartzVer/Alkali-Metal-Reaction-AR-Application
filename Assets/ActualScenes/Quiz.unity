  feedbackTextUI: {fileID: 1185149982}
  correctColor: {r: 0, g: 1, b: 0, a: 1}
  incorrectColor: {r: 1, g: 0, b: 0, a: 1}
  feedbackDelay: 0.5
  masterQuestionList:
  - questionText: Which alkali metal is the most reactive?
    answers:
    - Hydrogen
    - Sodium
    - Lithium
    - Potassium
    correctIndex: 3
  - questionText: Which alkali metal is the lightest metal?
    answers:
    - Lithium
    - Sodium
    - Potassium
    - Hydrogen
    correctIndex: 0
  - questionText: Why are lithium, sodium and potassium stored in oil?
    answers:
    - To increase reactivity
    - To prevent tarnishing in air
    - To make them float
    - To cool metals
    correctIndex: 1
  - questionText: Which alkali metal reacts most gently with water?
    answers:
    - Lithium
    - Sodium
    - Potassium
    - All react equally
    correctIndex: 0
  - questionText: What products are formed when sodium reacts with water?
    answers:
    - Sodium chloride and hydrogen
    - Sodium hydroxide and hydrogen gas
    - Sodium oxide and oxygen
    - Water and oxygen
    correctIndex: 1
  - questionText: Which gas is released during the reactions of lithium, sodium and
      potassium with water?
    answers:
    - Oxygen
    - Carbon dioxide
    - Hydrogen
    - Nitrogen
    correctIndex: 2
  - questionText: Which alkali metal produces a lilac-purple flame during the reaction?
    answers:
    - Lithium
    - Sodium
    - Potassium
    - Hydrogen
    correctIndex: 2
  - questionText: Which alkali metal produces a bright yellow flame?
    answers:
    - Lithium
    - Sodium
    - Potassium
    - Hydrogen
    correctIndex: 1
  - questionText: Why does potassium react more violently than lithium?
    answers:
    - Potassium loses its outer electron more easily
    - Potassium has fewer electrons
    - Potassium is lighter
    - Potassium has fewer shells
    correctIndex: 0
  - questionText: What is the correct reactivity order of the three alkali metals?
    answers:
    - Potassium > Sodium > Lithium
    - Lithium > Sodium > Potassium
    - Sodium > Lithium > Potassium
    - Sodium > Potassium > Lithium
    correctIndex: 0
  - questionText: Which equation represents sodium reacting with water?
    answers:
    - "2Na + 2H<sub>2</sub>O \u2192 2NaOH + H<sub>2</sub>"
    - "Na + H<sub>2</sub> \u2192 NaH"
    - "2Na + Cl<sub>2</sub> \u2192 2NaCl"
    - "4Na + O<sub>2</sub> \u2192 2Na<sub>2</sub>O"
    correctIndex: 0
  - questionText: What is the chemical formula of sodium hydroxide?
    answers:
    - NaCl
    - H<sub>2</sub>O
    - NaOH
    - Na<sub>2</sub>O
    correctIndex: 2
  - questionText: How many outer electrons does sodium have?
    answers:
    - 8
    - 2
    - 1
    - 11
    correctIndex: 2
  - questionText: Which alkali metal has the electron arrangement 2,8,1?
    answers:
    - Lithium
    - Sodium
    - Potassium
    - Hydrogen
    correctIndex: 1
  - questionText: Which alkali metal has the electron arrangement 2,8,8,1?
    answers:
    - Lithium
    - Sodium
    - Potassium
    - Hydrogen
    correctIndex: 2
